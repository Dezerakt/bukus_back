# App
APP_NAME=bukus
APP_VERSION=1.0.0

# HTTP
HTTP_PORT=8080

# Log
LOG_LEVEL=debug

# Postgres
PG_POOL_MAX=10
PG_URL=postgres://user:password@postgres:5432/bukus?sslmode=disable

# JWT
JWT_SECRET=your-secret-key
JWT_TOKEN_EXPIRY=24h

# Metrics
METRICS_ENABLED=true

# Swagger
SWAGGER_ENABLED=false
